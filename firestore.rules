rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Security Invariants
    // ===============================================================
    //
    // 1. /users/{userId}
    //    - Fields: id, email, name, firstName, lastName, phone, role ('customer' | 'employee' | 'provider' | 'admin'),
    //      state, createdAt
    //    - Security: Only owner or admin can read individual profile; only admin can list users.
    //      Non-admin users cannot self-assign or escalate their `role` to 'admin'.
    //
    // 2. /employees/{employeeUid}
    //    - Fields: id, userId, status ('applicant' | 'training' | 'active' | 'rejected'), onboardingStep,
    //      address, aptSuite, city, state, zipCode, businessName, businessDescription, hasDotVehicle,
    //      affiliation, source, verification, availability, assignedJobIds, createdAt
    //    - Security: Only owner or admin can get; only admin can list or change `status` (e.g. to 'active').
    //
    // 3. /providers/{providerUid}
    //    - Fields: uid, businessName, email, phone, bio, status ('pending' | 'approved' | 'suspended'),
    //      isEmployee, services, hourlyRate, minimumHours, rating, reviewCount, location, geohash,
    //      onboarding, onboardingStep, stripeAccountId, stripeOnboardingComplete, termsAccepted
    //    - Security: Publicly readable for marketplace discovery. Providers can only create with
    //      `status == 'pending'` and cannot modify their own `status` on update (only admins can approve/suspend).
    //
    // 4. /quotes/{id}
    //    - Fields: customerId, name, email, phone, pickupZip, dropoffZip, moveDate, moveSize,
    //      specialItems, estimatedTotal, preferredProviderId, status ('new' | 'processed' | 'expired'),
    //      details, createdAt
    //    - Security: Readable and updatable by the quote's customer or an admin; creatable for quote intake.
    //
    // 5. /announcements/{id}, /applications/{id}, /jobs/{id}, /jobs/{id}/messages/{messageId}
    //    - Scoped to authorized participants and administrators.
    // ===============================================================

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(userPath) && get(userPath).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // Keep this published version in sync with src/lib/terms.ts. The tests use
    // that shared constant and exercise a real serverTimestamp transform.
    function acceptedCurrentTerms(acceptance, context) {
      return acceptance is map &&
        acceptance.keys().hasOnly(['accepted', 'version', 'documentPath', 'acceptedBy', 'context', 'acceptedAt']) &&
        acceptance.get('accepted', false) == true &&
        acceptance.get('version', '') == '2026-11-08' &&
        acceptance.get('documentPath', '') == '/terms/2026-11-08' &&
        acceptance.get('acceptedBy', '') == request.auth.uid &&
        acceptance.get('context', '') == context &&
        acceptance.get('acceptedAt', null) == request.time;
    }

    function canAccessJob(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return isAdmin() || 
             job.customerId == request.auth.uid || 
             (job.providerIds != null && request.auth.uid in job.providerIds) || 
             (job.employeeIds != null && request.auth.uid in job.employeeIds);
    }

    // Rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isAdmin() && !('termsAcceptance' in request.resource.data)) || (
        // Self-signup can never create an admin. Admins are granted only by
        // an existing admin (or server-side with the Admin SDK).
        isOwner(userId) &&
        request.resource.data.role in ['customer', 'employee', 'provider'] &&
        ((request.resource.data.role != 'customer' && !('termsAcceptance' in request.resource.data)) || acceptedCurrentTerms(request.resource.data.get('termsAcceptance', {}), 'signup'))
      );
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['termsAcceptance']) && (isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role
      ));
      allow delete: if isAdmin();
    }

    match /employees/{employeeUid} {
      allow get: if isOwner(employeeUid) || isAdmin();
      allow list: if isAdmin();
      allow create: if (!('applicationAcknowledgment' in request.resource.data) || (
        isOwner(employeeUid) &&
        request.resource.data.applicationAcknowledgment.keys().hasOnly(['accepted', 'version', 'acceptedBy', 'acceptedAt']) &&
        request.resource.data.applicationAcknowledgment.accepted == true &&
        request.resource.data.applicationAcknowledgment.version == '2026-11-08' &&
        request.resource.data.applicationAcknowledgment.acceptedBy == request.auth.uid &&
        request.resource.data.applicationAcknowledgment.acceptedAt == request.time
      )) && (isAdmin() || (
        isOwner(employeeUid) &&
        (!('status' in request.resource.data) || request.resource.data.status != 'active')
      ));
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['applicationAcknowledgment']) && (isAdmin() || (
        isOwner(employeeUid) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
      ));
      allow delete: if isAdmin();
    }

    // Fields only the server (payout setup, reviews) or an admin may set.
    function providerProtectedFields() {
      return ['status', 'stripeAccountId', 'stripeOnboardingComplete', 'rating', 'reviewCount'];
    }

    match /providers/{providerUid} {
      allow read: if true;
      allow create: if isAdmin() || (
        isOwner(providerUid) &&
        request.resource.data.status == 'pending' &&
        !('stripeAccountId' in request.resource.data) &&
        !('stripeOnboardingComplete' in request.resource.data) &&
        request.resource.data.get('rating', 0) == 0 &&
        request.resource.data.get('reviewCount', 0) == 0
      );
      allow update: if isAdmin() || (
        isOwner(providerUid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(providerProtectedFields())
      );
      allow delete: if isAdmin();

      // One review per completed job, written by that job's customer. The
      // review's ID is the job ID.
      match /reviews/{jobId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.jobId == jobId &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
          get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId == request.auth.uid &&
          get(/databases/$(database)/documents/jobs/$(jobId)).data.status == 'completed' &&
          providerUid in get(/databases/$(database)/documents/jobs/$(jobId)).data.providerIds;
        allow update, delete: if isAdmin();
      }
    }

    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /applications/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Checkout tracking is server-managed; customers may only edit quote details.
    function quotePaymentFields() {
      return ['checkoutSessionId', 'paymentStatus', 'paymentFailedAt', 'bookingTermsAcceptance'];
    }
    match /quotes/{id} {
      allow read: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      // Quotes come from signed-in customers, for themselves, starting as 'new'.
      allow create: if !request.resource.data.keys().hasAny(['isCustomQuote', 'pricing', 'expiresAt', 'createdBy', 'openedAt']) && ((isAdmin() && !request.resource.data.keys().hasAny(['termsAcceptance', 'bookingTermsAcceptance'])) || (isSignedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'new' &&
        acceptedCurrentTerms(request.resource.data.get('termsAcceptance', {}), 'quote') &&
        !request.resource.data.keys().hasAny(quotePaymentFields())));
      // Customers may edit their quote's details, but not reassign it or change its status.
      allow update: if (!resource.data.get('isCustomQuote', false) || (isAdmin() && changedOnly(['status']))) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isCustomQuote', 'pricing', 'expiresAt', 'createdBy', 'openedAt', 'termsAcceptance', 'bookingTermsAcceptance']) && (isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerId', 'status', 'checkoutSessionId', 'paymentStatus', 'paymentFailedAt', 'leadStatus', 'assignedTo', 'assignedAt', 'firstContactAt', 'lastContactAt', 'lostReason', 'lostBy', 'lostAt', 'leadNotifiedAt'])));
      allow delete: if isAdmin();
    }

    // Jobs are created, paid, completed and paid out by the server. In the
    // browser, each participant may change only their own small set of fields.
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function isJobProvider() {
      return isSignedIn() && resource.data.get('providerIds', []) is list &&
        request.auth.uid in resource.data.get('providerIds', []);
    }
    function isJobEmployee() {
      return isSignedIn() && resource.data.get('employeeIds', []) is list &&
        request.auth.uid in resource.data.get('employeeIds', []);
    }

    match /jobs/{id} {
      allow read: if (isSignedIn() && (resource.data.customerId == request.auth.uid ||
        (resource.data.employeeIds != null && request.auth.uid in resource.data.employeeIds) ||
        (resource.data.providerIds != null && request.auth.uid in resource.data.providerIds))) || isAdmin();
      allow create: if isAdmin() && !('termsAcceptance' in request.resource.data);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['termsAcceptance']) && (isAdmin() ||
        // Customer: mark the job reviewed.
        (isSignedIn() && resource.data.customerId == request.auth.uid &&
          changedOnly(['reviewed']) && request.resource.data.reviewed == true) ||
        // Provider: switch between confirmed and in-progress.
        (isJobProvider() && changedOnly(['status']) &&
          resource.data.status in ['confirmed', 'in-progress'] &&
          request.resource.data.status in ['confirmed', 'in-progress']) ||
        // Crew: field notes and crew status.
        (isJobEmployee() && changedOnly(['employeeNotes', 'crewStatus'])));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && canAccessJob(id);
        // Messages must be sent under the sender's own ID.
        allow create: if isSignedIn() && canAccessJob(id) && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Release codes. Only the customer and admins can read them; providers
    // never can. Written only by the server.
    match /jobSecrets/{jobId} {
      allow read: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // Default deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
